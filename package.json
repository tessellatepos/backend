    },
    "dependencies": {
        "@origranot/ts-logger": "^1.12.0",
        "@tessellatepos/plugin-sdk": "workspace:*",
        "@tessellatepos/sdk": "workspace:*",
        "@types/express": "^5.0.6",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.45.1",
        "express": "^5.2.1",
        "nanoid": "^5.1.6",
        "pg": "^8.23.0",
        "redis": "^5.10.0",
        "square": "^44.0.0",
        "ts-node": "^10.9.2",
        "tslog": "^4.10.2",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@tsconfig/node-ts": "^23.6.2",
        "@types/cors": "^2.8.19",
        "@types/node": "^25.0.9",
        "@types/pg": "^8.23.1",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.9",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "prettier": "^3.9.6",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.68.0"
    }
